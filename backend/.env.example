# Port the Express server listens on
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
# e.g. http://localhost:3000,https://qa.ecommetrica.com,https://ecommetrica.com
FRONTEND_URL=http://localhost:3000

# SMTP credentials used by nodemailer to send the contact form email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Destination inbox for contact form submissions
CONTACT_TO_EMAIL=
