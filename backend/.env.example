# Port the Express server listens on
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
# e.g. http://localhost:3000,https://qa.ecommetrica.com,https://ecommetrica.com
FRONTEND_URL=http://localhost:3000

# SMTP credentials used by nodemailer to send the contact form email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Destination inbox for contact form submissions
CONTACT_TO_EMAIL=

# Absolute path to the frontend's static export root on the same cPanel
# account (the folder containing 404.html, e.g. /home/srgenial/dev.ecommetrica.com).
# When set, the 404 fallback below serves that real Next.js-rendered page
# instead of the plain built-in one. Leave unset in local dev.
FRONTEND_STATIC_DIR=
